 		i_limit = i_h_limit * i_w_limit;
 
-		expr_bin = gnm_expr_new_constant (ftool->bin);
+		expr_bin = gnm_expr_new_constant (value_dup (ftool->bin));
 
 		for (i = 1; i <= i_h_limit; i++)
 			for (j = 1; j <= i_w_limit; j++) {
