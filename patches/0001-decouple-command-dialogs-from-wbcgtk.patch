 /**
+ * wb_control_query_yes_no:
+ * @wbc: #WorkbookControl
+ * @default_answer: the answer to suggest, and to return when the control
+ * cannot ask
+ * @question: the question text
+ *
+ * Asks the user a yes/no question through the control.
+ *
+ * Returns: %TRUE for yes.
+ **/
+gboolean
+wb_control_query_yes_no (WorkbookControl *wbc, gboolean default_answer,
+			 char const *question)
+{
+	WorkbookControlClass *wbc_class;
+
+	g_return_val_if_fail (GNM_IS_WBC (wbc), default_answer);
+
+	wbc_class = WBC_CLASS (wbc);
+	if (wbc_class != NULL && wbc_class->query_yes_no != NULL)
+		return wbc_class->query_yes_no (wbc, default_answer, question);
+	return default_answer;
+}
+
+/**
+ * wb_control_error_message:
+ * @wbc: #WorkbookControl
+ * @msg: the message
+ *
+ * Reports an error to the user through the control's #GOCmdContext.
+ **/
+void
+wb_control_error_message (WorkbookControl *wbc, char const *msg)
+{
+	GError *err;
+
+	g_return_if_fail (GNM_IS_WBC (wbc));
+
+	err = g_error_new_literal (go_error_invalid (), 0, msg);
+	go_cmd_context_error (GO_CMD_CONTEXT (wbc), err);
+	g_error_free (err);
+}
+
+/**
  * wb_control_view:
  * @wbc: #WorkbookControl
  *
